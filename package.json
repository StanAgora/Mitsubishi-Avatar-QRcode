{
  "name": "mitsubishi-avatar-qrcode",
  "private": true,
  "version": "0.1.0",
  "description": "Mitsubishi Avatar QR Code demo - Agora Conversational AI Agent with Avatar",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "build": "npm run build --workspace client",
    "start": "npm run build && npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
