PORT=8080

# Agora project used to mint RTC (+RTM) tokens for the browser client and
# the server-side agent/avatar participants.
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# RESTful API credentials (Customer ID / Secret from Agora Console -> RESTful API)
# used to call the Conversational AI Agent Engine API.
AGORA_CUSTOMER_ID=your_customer_id
AGORA_CUSTOMER_SECRET=your_customer_secret

# Conversational AI Agent Engine base URL.
AGORA_CONVO_AI_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2/projects

# Agent behavior
AGENT_IDLE_TIMEOUT=60
ENABLE_AIVAD=true
ENABLE_BHVS=true
ENABLE_RTM=true
ENABLE_TOOLS=false
ENABLE_DUMP=false
AUDIO_SCENARIO=aiserver
DATA_CHANNEL=rtm

# ASR vendor config
ASR_VENDOR=ares
ASR_LANGUAGE=ja-JP

# LLM config
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o
# LLM_SYSTEM_PROMPT is left unset so the system prompt loads from external/prompt.md
# {{XXX}} is substituted with the visitor name typed into the PC landing page
# (falls back to a name-less greeting if left blank).
LLM_GREETING_MESSAGE=ご訪問ありがとうございます。{{XXX}}、私は三菱のAIアシスタント、インスパイアです。どなたをお探しですか？それとも、他に何かお手伝いできることはありますか？
LLM_FAILURE_MESSAGE=申し訳ございません、もう一度お問い合わせ内容をお伝えいただけますでしょうか？
LLM_MAX_HISTORY=32

# TTS vendor config (minimax)
TTS_VENDOR=minimax
TTS_KEY=
TTS_URL=wss://api-uw.minimax.io/ws/v1/t2a_v2
TTS_MODEL=speech-02-turbo
TTS_GROUP_ID=
TTS_VOICE_ID=jap_female_1222_1
TTS_SAMPLE_RATE=8000
TTS_LANGUAGE_BOOST=auto

# Avatar vendor config
AVATAR_VENDOR=akool
AVATAR_ENABLED=true
AVATAR_API_KEY=
AVATAR_ID=
