# Combined env file for the Docker/CI deploy path (quick-deploy.sh +
# docker-compose.yml): frontend build-time vars (VITE_*) and backend
# runtime vars live together here. For local `npm run dev` instead, use
# client/.env.example and server/.env.example (kept separate there since
# Vite only loads client/.env at dev/build time).

# ---- Frontend (build-time only — baked into the static bundle) ----
VITE_AGORA_APP_ID=your_agora_app_id

# ---- Backend (runtime) ----
PORT=8080

# Agora project used to mint RTC (+RTM) tokens for the browser client and
# the server-side agent/avatar participants. Must match VITE_AGORA_APP_ID above.
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# RESTful API credentials (Customer ID / Secret from Agora Console -> RESTful API)
# used to call the Conversational AI Agent Engine API.
AGORA_CUSTOMER_ID=your_customer_id
AGORA_CUSTOMER_SECRET=your_customer_secret

# Conversational AI Agent Engine base URL.
AGORA_CONVO_AI_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2/projects

# Agent behavior
AGENT_IDLE_TIMEOUT=60
ENABLE_AIVAD=true
ENABLE_BHVS=true
ENABLE_RTM=true
ENABLE_TOOLS=false
ENABLE_DUMP=false
AUDIO_SCENARIO=aiserver
DATA_CHANNEL=rtm

# ASR vendor config
ASR_VENDOR=ares
ASR_LANGUAGE=ja-JP

# LLM config
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o
# LLM_SYSTEM_PROMPT is left unset so the system prompt loads from external/prompt.md
# greeting_message / failure_message are now selected per-language (ja/en/zh)
# from the PC's language page — see GREETING_BY_LANGUAGE / FAILURE_BY_LANGUAGE
# in agentProfile.js.
LLM_MAX_HISTORY=32

# TTS vendor config (minimax)
TTS_VENDOR=minimax
TTS_KEY=
TTS_URL=wss://api-uw.minimax.io/ws/v1/t2a_v2
TTS_MODEL=speech-02-turbo
TTS_GROUP_ID=
TTS_SAMPLE_RATE=16000
# voice_id / language_boost are now selected per-language on the PC's
# language page (ja/en/zh) — see TTS_VOICE_BY_LANGUAGE in agentProfile.js.

# Avatar vendor config
AVATAR_VENDOR=akool
AVATAR_ENABLED=true
AVATAR_API_KEY=
AVATAR_ID=
